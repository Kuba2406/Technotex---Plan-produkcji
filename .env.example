# Environment variables for Technotex – Plan produkcji
# Copy this file to .env.local and fill in your values.

# -------------------------------------------------------
# Supabase (optional – required only for cloud database)
# -------------------------------------------------------
# Create a free project at https://supabase.com
# Then paste your project URL and anon key below.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# -------------------------------------------------------
# Storage backend selector
# -------------------------------------------------------
# "memory"  = in-memory store, data resets on server restart (default for local dev)
# "supabase" = persists data in Supabase/PostgreSQL
# "file"     = persists data as JSON file in /data/ (simple self-hosted option)

STORAGE_BACKEND=memory

# Path for file-based backend (relative to project root)
DATA_FILE_PATH=./data/app-state.json

# -------------------------------------------------------
# Optional: simple shared-access token
# -------------------------------------------------------
# Enables a minimal PIN/token check for API routes.
# Leave empty to skip authentication entirely.

API_ACCESS_TOKEN=
